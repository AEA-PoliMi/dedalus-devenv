# Copy to .env and adjust. .env is git-ignored.

# One ROS domain ID per person on a shared machine, so your nodes and topics
# never mix with a teammate's graph. Pick any number 0-101.
ROS_DOMAIN_ID=7

# Per-user compose project name (dedalus-<name>). Two people on one machine
# must use different names, or they collide on / replace each other's containers.
COMPOSE_PROJECT_NAME=dedalus-anna

# CARLA runs once per machine, started by the host owner. Host owner: set
# COMPOSE_PROFILES=sim so `docker compose up -d` also starts CARLA and waits
# for it. Guests: leave it empty; `docker compose up -d` starts only ros2.
COMPOSE_PROFILES=

# CARLA simulator image tag. Must match the carla Python client baked into the
# ros2 image (0.9.16).
CARLA_VERSION=0.9.16

# Host paths bind-mounted into the ros2 container. Create them before the
# first `docker compose up` (mkdir -p ws/src bags) or point them at your own
# colcon workspace (the directory that contains src/).
# Guests: /home/<host>/<guest>/ws and /home/<host>/<guest>/bags.
WS_PATH=./ws
BAGS_PATH=./bags

# Your host user/group IDs, so files written in /ws and /bags stay yours.
# Find them with:  id -u ; id -g
HOST_UID=1000
HOST_GID=1000
